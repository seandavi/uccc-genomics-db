[Unit]
Description=UCCC Genomics MCP (v2) Server on Tailnet
Documentation=file:///home/davsean/Documents/git/uccc-genomics-db/mcp/README.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/davsean/Documents/git/uccc-genomics-db
ExecStart=%h/.local/bin/uv run genomics-mcp --transport sse --host 0.0.0.0 --port 8088
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
