# Site-specific, non-secret values read by src/uccc_genomics/config.py. Copy to .env.
CARIS_BUCKET=s3://your-caris-bucket/
FMI_SRC=fmi-host:/path/to/xml/dir
# STALE_DAYS=21   # genomics check fails when a vendor's newest received date is older than this
# DATABASE_URL=postgresql://<role>:<password>@<host>:5432/<database>   # secret: real value only in .env
# Campus sign-in (genomics-app --auth authentik); see README "Campus sign-in (Authentik)"
# AUTHENTIK_ISSUER=https://<authentik-host>/application/o/uccc-genomics/   # must end with /
# AUTHENTIK_CLIENT_ID=uccc-genomics
# AUTHENTIK_CLIENT_SECRET=<client-secret>   # secret: real value only in .env
# APP_BASE_URL=http://<tailnet-addr>:8092   # the URL users open; <APP_BASE_URL>/auth/callback is a Strict redirect URI on the provider
# SESSION_SECRET=<48+ random characters>   # secret: real value only in .env; python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTHENTIK_GROUP=uccc-genomics-dashboard   # optional; this is the default
