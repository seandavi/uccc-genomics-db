{
  "name": "uccc-genomics-discover",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen": "cd .. && uv run python -c \"import json; from uccc_genomics_mcp.app import app; print(json.dumps(app().openapi(), indent=2, sort_keys=True))\" > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api.gen.ts",
    "typecheck": "openapi-typescript openapi.json -o src/api.gen.ts --check && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
